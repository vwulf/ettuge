import MiniLean.Expr

/-!
# The environment

An environment is the ordered list of declarations accepted so far. Nothing
gets into it except through the checks in `MiniLean.Kernel`.

There are five kinds of declaration:
* a **definition**, whose value the kernel may unfold (δ-reduction);
* a **theorem**, whose proof is checked once and never unfolded;
* an **inductive type**, given by its constructors;
* a **constructor** of an inductive type;
* a **recursor**, generated by the kernel from an inductive type. It is the
  only way to use a value of that type, and running it on a constructor is
  ι-reduction.
-/

namespace MiniLean

inductive ConstInfo where
  | defn (lps : List Name) (type value : Expr)
  | thm (lps : List Name) (type value : Expr)
  | induct (lps : List Name) (type : Expr) (numParams numIndices : Nat) (ctors : List Name)
  | ctor (lps : List Name) (type : Expr) (ind : Name) (idx numParams numFields : Nat)
  | recursor (lps : List Name) (type : Expr) (ind : Name) (numParams numIndices : Nat)
      (ctors : List Name) (largeElim : Bool)
  deriving Inhabited

namespace ConstInfo

def lps : ConstInfo → List Name
  | defn l .. | thm l .. | induct l .. | ctor l .. | recursor l .. => l

def type : ConstInfo → Expr
  | defn _ t _ | thm _ t _ | induct _ t .. | ctor _ t .. | recursor _ t .. => t

def kind : ConstInfo → String
  | defn .. => "definition"
  | thm .. => "theorem"
  | induct .. => "inductive type"
  | ctor .. => "constructor"
  | recursor .. => "recursor"

end ConstInfo

structure Env where
  consts : Array (Name × ConstInfo) := #[]
  deriving Inhabited

namespace Env

def find? (env : Env) (n : Name) : Option ConstInfo :=
  (env.consts.find? (·.1 == n)).map (·.2)

def contains (env : Env) (n : Name) : Bool := (env.find? n).isSome

def add (env : Env) (n : Name) (c : ConstInfo) : Env :=
  { env with consts := env.consts.push (n, c) }

end Env
end MiniLean
